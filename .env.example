# NoneBot / OneBot V11 listener. Copy this file to .env and replace examples.
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/",""]
SUPERUSERS=["123456789"]

# Project-local runtime directories; all are ignored by Git.
AMADEUS_ENV=prod
AMADEUS_DATA_DIR=data
AMADEUS_LOG_DIR=logs
AMADEUS_API_KEY_FILE=secrets/apikey.txt
AMADEUS_AI_ROUTES_FILE=config/ai_routes.toml

# Optional campus read-only integrations. Keep credentials in secrets/, never here.
AMADEUS_PORTAL_COOKIE_FILE=secrets/portal-cookie.txt
AMADEUS_JWGL_COOKIE_FILE=secrets/jwgl-cookie.txt
AMADEUS_ACTIVITY_TOKEN_FILE=secrets/activity-token.txt
AMADEUS_PASSWORD_FILE=secrets/campus-password.txt
AMADEUS_ACTIVITY_LIST_ENDPOINT=/api/v1/replace-with-confirmed-list-endpoint
AMADEUS_PORTAL_BROWSER_HEADLESS=false
AMADEUS_SEMESTER_START=2026-08-31
AMADEUS_CAMPUS_PUSH_HOUR=8
